# Headers customizados para Cloudflare Pages
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Este arquivo controla os headers HTTP enviados pelo Cloudflare Pages.
# As regras são aplicadas em ordem, da mais específica para a mais geral.

# ============================================================
# Sitemap.xml
# - Content-Type explícito (Googlebot reconhece como XML)
# - no-transform impede Cloudflare de aplicar compressão Brotli/Gzip
#   automaticamente, que estava impedindo o Googlebot de ler o sitemap
# - X-Content-Type-Options nosniff impede crawler de "adivinhar" o tipo
# ============================================================
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, no-transform
  X-Content-Type-Options: nosniff

# ============================================================
# Robots.txt — Content-Type correto, cache de 24h, sem compressão
# ============================================================
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, no-transform

# ============================================================
# Páginas HTML — segurança e SEO
# Aplica a todas as páginas .html do site (home, blog, institucionais)
# ============================================================
/*.html
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: index, follow

# ============================================================
# Página inicial (raiz) — equivalente à index.html
# ============================================================
/
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: index, follow
