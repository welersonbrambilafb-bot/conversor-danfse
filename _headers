# Headers customizados para Cloudflare Pages
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Este arquivo controla os headers HTTP enviados pelo Cloudflare Pages.
# As regras são aplicadas em ordem, da mais específica para a mais geral.

# ============================================================
# Sitemap.xml — força Content-Type explícito e cache curto
# Resolve o problema de Googlebot não conseguir ler sitemaps
# servidos com compressão brotli sem Content-Type explícito.
# ============================================================
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

# ============================================================
# Robots.txt — Content-Type correto e cache moderado
# ============================================================
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# ============================================================
# Páginas HTML — segurança e SEO
# Aplica a todas as páginas .html do site (home, blog, institucionais)
# ============================================================
/*.html
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: index, follow

# ============================================================
# Página inicial (raiz) — equivalente à index.html
# ============================================================
/
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: index, follow
